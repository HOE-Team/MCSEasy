# ============================================================
# MCSEasy .gitignore
#
# 原则：只忽略「本机生成、可重新生成、体积大」的文件；
#      源码、资源（svg/、images/、icon.*）、文档、测试一律入库。
# ============================================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/

# ---------- 虚拟环境 ----------
.venv/
venv/
env/
ENV/

# ---------- 打包 / 构建产物 ----------
build/
dist/
*.spec
# 本地验证 PyInstaller 打包时的临时目录
_buildtest/

# ---------- 测试与类型检查缓存 ----------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/

# ---------- 编辑器 / 操作系统 ----------
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ---------- 日志与临时文件 ----------
logs/
*.log
*.tmp
*.part
*.bak
*.orig
*.rej

# ---------- MCSEasy 项目相关 ----------
# 本地用来手动测试开服的服务器目录（通常几十 MB 的 jar），不入库
testsvr/
# 应用默认把数据写在用户目录（%APPDATA%/MCSEasy 等）；
# 如果有人用 MCSEASY_DATA_DIR 指到仓库里，下面的内容也不该入库
assets/
servers/
